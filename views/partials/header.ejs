<header class="site-header">
  <div class="container">
    <a href="/" class="logo">
      <img src="/img/logo-white.svg" alt="<%= site.naam %>">
    </a>
    <nav class="main-nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <a href="/aanbod" class="<%= path.startsWith('/aanbod') ? 'active' : '' %>">Aanbod</a>
      <a href="/over-ons" class="<%= path === '/over-ons' ? 'active' : '' %>">Contact</a>
      <a href="/admin" class="btn btn-outline btn-sm">Beheer</a>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo"><img src="/img/logo-white.svg" alt="<%= site.naam %>"></div>
          <p>Als petrolheads weten we welke auto's leuk zijn en welke hun waarde goed zullen behouden of zelfs in waarde zullen toenemen. Wij helpen je graag de juiste te vinden.</p>
        </div>
        <div>
          <h4>Navigatie</h4>
          <ul>
            <li><a href="/aanbod">Ons aanbod</a></li>
            <li><a href="/over-ons">Contact</a></li>
            <li><a href="https://shop.team262.nl" target="_blank" rel="noopener">Team 262 Shop</a></li>
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href="tel:<%= site.telefoonHref %>"><%= site.telefoon %></a></li>
            <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
            <li><%= site.adres %><br><%= site.plaats %></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; <%= new Date().getFullYear() %> <%= site.naam %>. Alle rechten voorbehouden.</span>
        <span>KvK <%= site.kvk %></span>
      </div>
    </div>
  </footer>

  <!-- Structured data (schema.org) over het bedrijf zelf — helpt zoekmachines
       bedrijfsgegevens (naam, adres, telefoon) correct te herkennen, bv. voor
       een kennispaneel of lokale zoekresultaten. -->
  <script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AutoDealer',
    name: site.naam,
    url: siteUrl + '/',
    telephone: site.telefoon,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.adres,
      addressLocality: site.plaats,
      addressCountry: 'NL',
    },
  }) %></script>

  <%- include('cookie-banner') %>
  <script src="/js/main.js"></script>
  <script src="/js/cookie-consent.js"></script>
</body>
</html>

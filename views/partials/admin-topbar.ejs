<div class="admin-shell">
  <div class="container">
    <div class="admin-topbar">
      <a href="/admin" class="logo"><img src="/img/logo-white.svg" alt="<%= site.naam %>"></a>
      <div class="admin-topbar-right">
        <a href="/admin/instellingen" class="muted">Instellingen</a>
        <a href="/" target="_blank" class="muted">Bekijk site ↗</a>

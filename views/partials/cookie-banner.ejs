<% if (gaId) { %>
  <div id="cookie-banner" class="cookie-banner">
    <div class="cookie-banner-text">
      <p>Wij gebruiken analytische cookies om te zien hoe bezoekers onze website gebruiken, zodat we de site kunnen verbeteren. Ga je hiermee akkoord?</p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-outline btn-sm" data-cookie-decline>Weigeren</button>
      <button type="button" class="btn btn-primary btn-sm" data-cookie-accept>Accepteren</button>
    </div>
  </div>
<% } %>

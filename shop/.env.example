# =============================================================================
# Team262 Shop — Environment Variables
# Kopieer dit bestand naar .env en vul de waarden in
# =============================================================================

# PostgreSQL connectie-URL (lokaal: database uit shop/docker-compose.yml op poort 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/team262shop"

# Admin login (/admin)
# ADMIN_PASSWORD:  wachtwoord voor de beheeromgeving
# SESSION_SECRET:  willekeurige geheime string, min. 16 tekens (genereer met: openssl rand -base64 32)
ADMIN_PASSWORD="kies-een-sterk-wachtwoord"
SESSION_SECRET="vervang-dit-met-een-willekeurige-geheime-string"

# Publieke instellingen (worden bij de build in de site gebakken)
NEXT_PUBLIC_MAIN_SITE_URL="https://team262.nl"
NEXT_PUBLIC_CONTACT_EMAIL="info@team262.nl"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_SHIPPING_COST="6.95"
NEXT_PUBLIC_FREE_SHIPPING_FROM="75"

# Alleen voor deploy/docker-compose.prod.yml: wachtwoord van de PostgreSQL-container
POSTGRES_PASSWORD=""

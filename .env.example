# Kopieer dit bestand naar ".env" en pas de waarden aan voor jouw server.

# Poort waarop de website draait
PORT=3000

# Geheime sleutel voor sessies/cookies. Verander dit naar een lange, willekeurige
# tekenreeks voordat je live gaat (bv. met: openssl rand -hex 32)
SESSION_SECRET=verander-dit-in-een-lange-willekeurige-sleutel

# Zet op "true" zodra de site achter HTTPS draait (aanbevolen in productie),
# zodat login-cookies alleen via een beveiligde verbinding worden verstuurd.
COOKIE_SECURE=false

# Gegevens voor het admin-account dat wordt aangemaakt met "npm run create-admin"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=verander-dit-wachtwoord

# -----------------------------------------------------------------------------
# E-MAIL (contactformulier)
# Laat deze leeg om berichten alleen in de serverlogs te laten verschijnen.
# Vul ze in om binnenkomende contactformulieren echt als e-mail te ontvangen.
# SMTP_PORT 587 = TLS/STARTTLS (meest gangbaar), 465 = SSL
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Team262 <noreply@team262.nl>
CONTACT_TO=info@team262.nl

# -----------------------------------------------------------------------------
# HCAPTCHA (spambescherming op het contactformulier)
# Laat deze leeg om de spamcontrole over te slaan (het formulier blijft dan
# gewoon werken, alleen zonder bot-bescherming).
# Maak een gratis account op hcaptcha.com voor je eigen sleutels, of gebruik
# onderstaande officiële testsleutels tijdens het lokaal ontwikkelen:
#   site key:   10000000-ffff-ffff-ffff-000000000001
#   secret key: 0x0000000000000000000000000000000000000000
# -----------------------------------------------------------------------------
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
